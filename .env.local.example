# POS MSSQL холболтын тохиргоо (бүх POS дээр ижил)
POS_DB_USER=sa
POS_DB_PASSWORD=
POS_DB_NAME=DCSPS
POS_DB_PORT=1433

# Нөхөн дүүргэлтийн SQLite сангийн зам (заавал биш; анхдагч: <project>/data/replenish.db)
REPLENISH_DB_PATH=

# --- ДЕМО ГОРИМ (GS25 танилцуулга) -----------------------------------------
# Дээрх REPLENISH_DB_PATH-ыг demo.db руу заагаад доорхийг 1 болгоно:
#   REPLENISH_DB_PATH=data/demo.db
#   NEXT_PUBLIC_DEMO_MODE=1
#
# Демо горимд: POS IP тохиргоо, "Дата цэвэрлэх/Устгах" товч нуугдана,
# gs25.mn руу гадаад дуудлага хийхгүй, толгойд ДЕМО тэмдэг гарна.
#
# Runbook (дараалал чухал):
#   1) next dev-ийг ЗОГСООХ  (seed нь бичих түгжээ авна)
#   2) npm run seed:demo:reset            (~10-20 сек, 20 дэлгүүр үүснэ)
#   3) энэ хоёр мөрийг .env.local-д тавих
#   4) npm run dev  — ЗААВАЛ хүйтэн эхлүүлэх (DB зам module-level const,
#      globalThis кэш нь HMR-ийг даван гардаг тул reload хангалтгүй)
#   5) танилцуулгын өглөө дахин seed хийх (asOf = өчигдөр, хөдөлдөг)
#   6) production-д буцах: энэ хоёр мөрийг comment + хүйтэн restart
#
# Абсолют зам өгөх бол ЗӨВ ташуу зураас + хашилт хэрэглэнэ (dotenv нь \-ыг
# escape гэж үздэг):  REPLENISH_DB_PATH="D:/path/to/log-reader/data/demo.db"
# NEXT_PUBLIC_DEMO_MODE=

# POS-ийн нөөц/хаягдал/нийлүүлэлтийн хүснэгт probe-той таарахгүй бол энд бодит
# нэрийг зааж өгнө (заавал биш). Хүснэгтийн жинхэнэ нэрийг олохын тулд:
#   POST /api/pos-schema { "ip": "<POS IP>" }
# DATE талбар байхгүй бол хоосон орхиж болно (тухайн өдрийн snapshot гэж үзнэ).
# POS_STOCK_TABLE=TP_ST_SKU_STK
# POS_STOCK_ITEM=item_cd
# POS_STOCK_QTY=stk_qty
# POS_WASTE_TABLE=TP_ST_DISPOSAL
# POS_WASTE_DATE=disp_dt
# POS_WASTE_ITEM=item_cd
# POS_WASTE_QTY=disp_qty
# POS_DELIVERY_TABLE=TP_ST_IN
# POS_DELIVERY_DATE=in_dt
# POS_DELIVERY_ITEM=item_cd
# POS_DELIVERY_QTY=in_qty
